{
  "apps": {
    "layer4": {
      "servers": {
        "main": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match":[
                {
                  "http":[
                    {
                      "host": [
                        "livekit-turn.local.stoat.chat"
                      ]     
                    }
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "proxy",
                  "upstreams": [
                    {
                      "dial": [
                        "localhost:5349"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "match":[
                {
                  "http":[
                    {
                      "host": [
                        "livekit.local.stoat.chat"
                      ]     
                    }
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "proxy",
                  "upstreams": [
                    {
                      "dial": [
                        "localhost:7880"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "local.stoat.chat"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/january"
                                },
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "response": {
                                      "replace": {
                                        "Location": [
                                          {
                                            "replace": "/january/",
                                            "search_regexp": "^/"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "january:14705"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/january*"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/autumn"
                                },
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "response": {
                                      "replace": {
                                        "Location": [
                                          {
                                            "replace": "/autumn/",
                                            "search_regexp": "^/"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "autumn:14704"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/autumn*"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/gifbox"
                                },
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "response": {
                                      "replace": {
                                        "Location": [
                                          {
                                            "replace": "/gifbox/",
                                            "search_regexp": "^/"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "gifbox:14706"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/gifbox*"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/api"
                                },
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "response": {
                                      "replace": {
                                        "Location": [
                                          {
                                            "replace": "/api/",
                                            "search_regexp": "^/"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "api:14702"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/api*"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/ws"
                                },
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "response": {
                                      "replace": {
                                        "Location": [
                                          {
                                            "replace": "/ws/",
                                            "search_regexp": "^/"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "events:14703"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/ws"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "web:8080"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
